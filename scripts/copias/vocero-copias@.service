[Unit]
Description=Copias de Vocero para %i
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStartPre=/usr/bin/node /opt/vocero-copias/cli.mjs reanudar --instance %i
ExecStart=/usr/bin/node /opt/vocero-copias/cli.mjs tick --instance %i
ExecStopPost=/usr/bin/node /opt/vocero-copias/cli.mjs reanudar --instance %i
TimeoutStartSec=60min
TimeoutStopSec=3min
